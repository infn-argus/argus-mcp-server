# ARGUS configuration. Every section below is optional — the server boots
# fine with only EPICS configured; every other provider reports itself as
# "unconfigured" (not an error) until its variables are set.

# --- Server ---
ARGUS_TRANSPORT=stdio          # stdio | sse
ARGUS_SSE_HOST=127.0.0.1
ARGUS_SSE_PORT=8000
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_JSON=true            # false for a readable console renderer in local dev

# --- EPICS (Channel Access + pvAccess) ---
EPICS_CA_ADDR_LIST=
EPICS_CA_AUTO_ADDR_LIST=YES
EPICS_PVA_ADDR_LIST=

# --- Archiver Appliance ---
ARCHIVER_BASE_URL=

# --- ChannelFinder (device/PV metadata registry, the Device source of truth) ---
CHANNELFINDER_BASE_URL=
CHANNELFINDER_USERNAME=
CHANNELFINDER_PASSWORD=

# --- Kubernetes ---
KUBECONFIG=
K8S_NAMESPACE_DEFAULT=default
K8S_IOC_LABEL_SELECTOR_TEMPLATE=app=ioc,device={ioc_name}

# --- ArgoCD ---
ARGOCD_SERVER_URL=
ARGOCD_AUTH_TOKEN=

# --- Phoebus save-and-restore (read-only: search/browse configurations and
# snapshots, no restore/apply — see providers/saverestore/saverestore.py) ---
SAVERESTORE_BASE_URL=

# --- Logbook (olog-compatible) ---
LOGBOOK_BASE_URL=
LOGBOOK_USERNAME=
LOGBOOK_PASSWORD=

# --- Elasticsearch ---
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_DEFAULT_INDEX=argus-logs

# --- Loki (Kubernetes pod log history, distinct from Elasticsearch above) ---
LOKI_BASE_URL=
LOKI_DEFAULT_LIMIT=200

# --- Documentation search ---
# "local" (default) indexes DOCS_PATH with TF-IDF. "ragflow" delegates
# search_documentation to an existing RAGFLOW deployment's REST retrieval
# API instead — set RAGFLOW_BASE_URL/RAGFLOW_API_KEY below and the DOCS_*
# vars are ignored.
DOCUMENTATION_BACKEND=local
DOCS_PATH=
DOCS_INDEX_PATH=

# --- RAGFLOW (only used when DOCUMENTATION_BACKEND=ragflow) ---
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
# Comma-separated dataset IDs to restrict search to. Left unset, search
# covers every dataset the API key can access (slower).
RAGFLOW_DATASET_IDS=
RAGFLOW_TIMEOUT_SECONDS=20

# --- ARGUS Knowledge Hub (argus-knowledge-hub's MCP server) ---
# An alternative source for three things the legacy setup reads from the
# beamline's deploy YAML, a RAG and Olog. Each switch is independent, so a
# hub-backed and a YAML-backed ARGUS can run side by side and be compared.
#   INVENTORY_BACKEND=yaml|knowledge_hub      list_beamline_devices
#   DOCUMENTATION_BACKEND=...|knowledge_hub   search_documentation (above)
#   LOGBOOK_BACKEND=olog|knowledge_hub        logbook reads; posting stays on Olog
INVENTORY_BACKEND=yaml
LOGBOOK_BACKEND=olog
# The hub's MCP endpoint, e.g. https://argus-hub-api.example.org/mcp
KNOWLEDGE_HUB_URL=
# A personal access token from the hub (My account -> Personal access
# tokens, argus_pat_...). To read EVERY workspace, an administrator makes it
# with the `read` and `admin` scopes and no fixed workspace; a read-only
# token reads only the workspaces its owner holds a role in.
KNOWLEDGE_HUB_TOKEN=
# Comma-separated workspace ids to ask in; blank = every one the token may read.
KNOWLEDGE_HUB_WORKSPACES=
KNOWLEDGE_HUB_TIMEOUT_SECONDS=20

# --- Caching ---
CACHE_DEVICE_TTL_SECONDS=300
CACHE_CHANNELFINDER_TTL_SECONDS=120
CACHE_KUBERNETES_TTL_SECONDS=30
CACHE_KNOWLEDGE_TTL_SECONDS=600
